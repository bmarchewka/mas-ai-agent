# ---------------------------------------------------------------------------
# secrets.env.example — template for local database credentials
# ---------------------------------------------------------------------------
# Copy this to `secrets.env` (which is gitignored) and fill in the value:
#
#     cp secrets.env.example secrets.env      # then edit secrets.env
#
# Step 5 (scripts/mas-manage-db-schema-export.sh) auto-loads secrets.env from
# the repo root if it exists, so the DB password never has to live in the
# tracked config.yaml. You can also just `export MAS_DB_PASSWORD=...` in your
# shell instead of using this file.
#
# Precedence: MAS_DB_PASSWORD (here / the environment) wins over whatever
# masManage.database.password says in config.yaml.
# ---------------------------------------------------------------------------
MAS_DB_PASSWORD=your-maximo-db-password-here
